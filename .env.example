# Copy to .env and fill in. Never commit .env.

# Required
PERSONAL_ACCESS_TOKEN_CLAUDE=sk-ant-...
API_TOKEN_TODOIST=...
API_TOKEN_TELEGRAM=123456789:ABC...

# Strongly recommended: your own Telegram user id (message @userinfobot to get it).
# Without it, anyone who finds the bot can edit your Todoist.
# TELEGRAM_ALLOWED_USER_IDS=123456789

# Optional tuning
# NEXUS_MODEL=claude-haiku-4-5
# NEXUS_MAX_TOOL_LOOPS=6
# TODOIST_API_BASE=https://api.todoist.com/api/v1
