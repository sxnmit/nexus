# Copy to .env and fill in. Never commit .env.

# Required
PERSONAL_ACCESS_TOKEN_CLAUDE=sk-ant-...
API_TOKEN_TODOIST=...
API_TOKEN_TELEGRAM=123456789:ABC...

# Strongly recommended: your own Telegram user id (message @userinfobot to get it).
# Without it, anyone who finds the bot can edit your Todoist.
# TELEGRAM_ALLOWED_USER_IDS=123456789

# Optional tuning
# NEXUS_MODEL=claude-haiku-4-5
# NEXUS_MAX_TOKENS=1024        # raise to ~8192 for a thinking model
# NEXUS_MAX_TOOL_LOOPS=6
# NEXUS_MAX_RETRIES=1             # retries the observe step may grant per message
# NEXUS_RETRY_BACKOFF_SECONDS=2   # pause before retrying a rate limit / outage
# TODOIST_API_BASE=https://api.todoist.com/api/v1

# Only if PERSONAL_ACCESS_TOKEN_CLAUDE is an org-level personal access token
# (Console -> Settings -> Workspaces). A key created inside a workspace
# doesn't need it.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Proactive check-ins. Times are in NEXUS_TIMEZONE -- set it on a host, where
# the clock is UTC and "08:00" would otherwise mean 8am UTC.
# NEXUS_TIMEZONE=America/Toronto
# TELEGRAM_CHAT_ID=123456789      # where check-ins go; defaults to the sole allowlisted id
# NEXUS_MORNING_TIME=08:00         # what's due today, what's overdue
# NEXUS_EVENING_TIME=21:00         # what got done vs what's still open
# NEXUS_QUIET_HOURS=22:00-07:00    # no proactive messages in this window
# NEXUS_OVERDUE_CHECK_MINUTES=15   # how often to look for timed tasks that went overdue

# Memory. The SQLite file with the interaction log, the learned habits and the
# scheduler's state. On a host, point it at a mounted volume (the Docker image
# defaults to /data/nexus.db) or it starts empty on every deploy.
# NEXUS_DB_PATH=nexus.db
# NEXUS_MEMORY_MESSAGES=10         # recent messages the agent sees per reply (0 = none)
# NEXUS_MEMORY_HOURS=12            # and how far back they may reach

# The record. Every run is stamped with the git commit it ran from, so a change
# in behaviour can be traced to a change in code. Railway sets
# RAILWAY_GIT_COMMIT_SHA itself; set this anywhere else, or leave it unknown.
# NEXUS_COMMIT=

# The judge. Grades each reply against a rubric once a night.
# NEXUS_JUDGE_MODEL=claude-haiku-4-5   # the agent's model by default
# NEXUS_JUDGE_TIME=03:00               # in NEXUS_TIMEZONE
# NEXUS_JUDGE_MAX_RUNS=50              # the most replies one pass will grade

# The reviewer. Proposes changes once a week and asks about one with buttons.
# NEXUS_REVIEW_MODEL=claude-haiku-4-5  # the agent's model by default
# NEXUS_REVIEW_DAY=0                   # 0-6, Sunday to Saturday
# NEXUS_REVIEW_TIME=18:00              # in NEXUS_TIMEZONE
# NEXUS_REVIEW_MIN_EVIDENCE=3          # distinct replies a proposal must cite
# NEXUS_REVIEW_ASK_DAYS=7              # at most one ask per this many days
# NEXUS_REVIEW_MIN_AGREEMENT=0.7       # the judge must agree with your labels this often to steer
# NEXUS_REVIEW_MIN_COMPARED=5          # ...once this many replies have both a label and a grade
# NEXUS_REVIEW_AGREEMENT_DAYS=30       # measured over this many days
# Where an approved suggestion goes: a GitHub issue when both are set (a
# fine-grained token with Issues: write on the repo), otherwise Nexus sends
# you the brief to paste into a Claude Code session.
# API_TOKEN_GITHUB=github_pat_...
# NEXUS_GITHUB_REPO=owner/name
